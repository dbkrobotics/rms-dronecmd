# Request
geometry_msgs/Point[] points
float32 speed
float32 tolerance
uint8 reference_frame    # 0=Relative, 1=Local-NED
uint8 yaw_mode           # 0=FacePath, 1=Keep
bool fly_through
int32 repeat
---
# Result
bool success
string message
---
# Feedback
int32 current_point_index
float32 distance_remaining
