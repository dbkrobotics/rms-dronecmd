# Required
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY

# ADK model for bidirectional voice interactions
VOICE_AGENT_MODEL=gemini-2.0-flash-live-001
VOICE_AGENT_RESPONSE_MODALITY=AUDIO
VOICE_AGENT_VOICE_NAME=Aoede

# Duplicate voice command suppression window (seconds)
VOICE_AGENT_DUPLICATE_WINDOW_SEC=8
# Pending command confirmation timeout (seconds)
VOICE_AGENT_CONFIRM_TIMEOUT_SEC=45

# ROS MCP direct connection (preferred over Gemini CLI bridge)
ROS_MCP_SERVER_PYTHON=/home/husl-ai/workspace/ros-mcp-server/venv/bin/python
ROS_MCP_SERVER_SCRIPT=/home/husl-ai/workspace/ros-mcp-server/server.py
ROS_MCP_TIMEOUT_SEC=30

# Web server
VOICE_AGENT_HOST=0.0.0.0
VOICE_AGENT_PORT=8787
VOICE_AGENT_LOG_LEVEL=INFO

# Optional ngrok reserved domain for smartphone testing
# VOICE_AGENT_NGROK_DOMAIN=example.ngrok-free.app
