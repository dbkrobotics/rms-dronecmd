# Required
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY

# ADK model for bidirectional voice interactions
VOICE_AGENT_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
VOICE_AGENT_RESPONSE_MODALITY=AUDIO
VOICE_AGENT_VOICE_NAME=Aoede

# Pending command confirmation timeout (seconds, motion/action commands)
VOICE_AGENT_CONFIRM_TIMEOUT_SEC=45

# ROS MCP direct connection (preferred over Gemini CLI bridge)
ROS_MCP_SERVER_PYTHON=/home/husl-ai/workspace/ros-mcp-server/venv/bin/python
ROS_MCP_SERVER_SCRIPT=/home/husl-ai/workspace/ros-mcp-server/server.py
ROS_MCP_TIMEOUT_SEC=30
# Optional explicit robot spec file (if not set, derived from ROS_MCP_SERVER_SCRIPT)
ROS_MCP_ROBOT_SPEC_PATH=/home/husl-ai/workspace/ros-mcp-server/robot_specifications/drone_px4.yaml
# Redirect ROS MCP stderr noise away from voice agent terminal output
VOICE_AGENT_WRAP_ROS_MCP_STDERR=true
ROS_MCP_STDERR_LOG_PATH=/tmp/ros_mcp_server_stderr.log

# Web server
VOICE_AGENT_HOST=0.0.0.0
VOICE_AGENT_PORT=8787
VOICE_AGENT_LOG_LEVEL=INFO
# Reduce third-party SDK noise (google_adk/google_genai) in terminal output
VOICE_AGENT_THIRD_PARTY_LOG_LEVEL=CRITICAL
# Print tool calls/results in terminal and forward to UI log
VOICE_AGENT_TRACE_TOOLS=true
VOICE_AGENT_TOOL_LOG_MAX_CHARS=900
# Retry transient live model disconnects (e.g., websocket 1011 internal errors)
VOICE_AGENT_LIVE_RETRY_COUNT=4
VOICE_AGENT_LIVE_RETRY_BACKOFF_SEC=1.0
# Drop oversized camera frames before forwarding to live model (bytes)
VOICE_AGENT_MAX_IMAGE_FRAME_BYTES=200000
VOICE_AGENT_CAMERA_WIDTH=1280
VOICE_AGENT_CAMERA_HEIGHT=720
VOICE_AGENT_CAMERA_CAPTURE_FPS=20
VOICE_AGENT_CAMERA_PREVIEW_FPS=4
VOICE_AGENT_CAMERA_MODEL_FPS=2
VOICE_AGENT_CAMERA_JPEG_QUALITY=65
VOICE_AGENT_CAMERA_RETRY_SEC=1.0

# Optional: object_locator model IDs (used by drone_controller launch)
DRONE_GEMINI_MODEL_ID=gemini-3.1-pro-preview
DRONE_GEMINI_API_VERSION=v1
DRONE_DEPTH_MODEL_ID=depth-anything/Depth-Anything-V2-Metric-Indoor-Small-hf
# Single-owner camera mode (recommended)
DRONE_CAMERA_FRAME_JPEG_URL=http://127.0.0.1:8787/api/camera/latest.jpg

# Optional ngrok reserved domain for smartphone testing
# VOICE_AGENT_NGROK_DOMAIN=example.ngrok-free.app
